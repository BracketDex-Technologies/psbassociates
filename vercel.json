{
  "buildCommand": "node build.mjs --origin=https://psbassociates.vercel.app",
  "outputDirectory": "dist",
  "framework": null,
  "regions": [
    "bom1"
  ],
  "functions": {
    "api/announcements.js": {
      "maxDuration": 30
    },
    "api/contact.js": {
      "maxDuration": 30
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=31536000"
        }
      ]
    }
  ]
}
